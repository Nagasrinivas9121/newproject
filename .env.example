# ==============================================================================
# SRIVANI BOOKING MANAGER - SAAS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in production and supply strong, unique secrets.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production
PROJECT_NAME="SRIVANI BOOKING MANAGER Cloud SaaS"
VERSION="8.0.0"

# JWT Secret Key (Generate with: openssl rand -hex 32)
# CRITICAL: Never commit the production secret key to version control.
SECRET_KEY=replace-with-a-64-character-cryptographically-secure-random-string

# Token Lifespan
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS_PER_MIN=5

# PostgreSQL Cloud Database Connection Strings
# AsyncPG for FastAPI Async Engine
DATABASE_URL=postgresql+asyncpg://srivani_admin:ChangeMeSecurePostgresPassword2026!@localhost:5432/srivani_saas
# Sync Driver for Alembic Migrations
SYNC_DATABASE_URL=postgresql://srivani_admin:ChangeMeSecurePostgresPassword2026!@localhost:5432/srivani_saas

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=srivani_admin
POSTGRES_PASSWORD=ChangeMeSecurePostgresPassword2026!
POSTGRES_DB=srivani_saas

# Private File Storage
STORAGE_DIR=./storage/tenants
MAX_FILE_SIZE_BYTES=10485760

# Initial Bootstrap Super Administrator
SUPER_ADMIN_EMAIL=superadmin@srivanimanager.com
SUPER_ADMIN_PASSWORD=SrivaniAdmin@2026!SecureChangeImmediately
SUPER_ADMIN_NAME="Platform Super Administrator"
